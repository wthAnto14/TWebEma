<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.7/dist/axios.min.js"></script>
</head>
<body class="bg-dark text-light">
<div id="person-details" class="container py-4">

    <!-- Dati anagrafici doppiatore -->
    <section class="row mb-4">
        <div class="col-md-3 text-center mb-3 mb-md-0">
            <img id="person-image"
                 src="/placeholder-person.jpg"
                 alt="Voice actor"
                 class="img-fluid rounded shadow-sm">
        </div>
        <div class="col-md-9">
            <h1 id="person-name" class="h2 mb-2">Caricamento...</h1>

            <p class="mb-1"><strong>Given name:</strong> <span id="person-given-name">—</span></p>
            <p class="mb-1"><strong>Family name:</strong> <span id="person-family-name">—</span></p>
            <p id="person-alt-names" class="text-muted mb-2"></p>

            <p id="person-birthday" class="mb-1">Birthday: —</p>
            <p id="person-favorites" class="mb-1">Favorites: —</p>
            <p id="person-location" class="mb-2">Location: —</p>

            <p id="person-website" class="mb-1">Website: —</p>
            <p class="mb-0">
                <a id="person-mal-link"
                   href="#"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-primary btn-sm mt-2">
                    View on MyAnimeList
                </a>
            </p>
        </div>
    </section>

    <!-- Ruoli da doppiatore -->
    <section class="mb-4">
        <h2 class="h4 mb-3">Voice Roles</h2>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-sm align-middle">
                <thead class="table-secondary text-dark">
                <tr>
                    <th id="vw-sort-anime" data-sort-key="animeTitle">Anime</th>
                    <th id="vw-sort-character" data-sort-key="characterName">Character</th>
                    <th id="vw-sort-role" data-sort-key="role">Role</th>
                    <th id="vw-sort-language" data-sort-key="language">Language</th>
                </tr>
                </thead>
                <tbody id="person-works-body"></tbody>
            </table>
        </div>

        <nav aria-label="Voice roles pagination" id="vw-pagination-nav" class="mt-3 d-none">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item">
                    <button class="page-link" id="vw-prev-page" type="button">Previous</button>
                </li>
                <li class="page-item disabled">
                    <span class="page-link" id="vw-page-info">Page 1 of 1</span>
                </li>
                <li class="page-item">
                    <button class="page-link" id="vw-next-page" type="button">Next</button>
                </li>
            </ul>
        </nav>
    </section>

    <div id="person-error" class="alert alert-danger d-none" role="alert"></div>
</div>

<script src="/javascripts/person-details.js"></script>
</body>
</html>
