<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.7/dist/axios.min.js"></script>
    <style>
        .text-light-50 { opacity: 0.6; }
        .anime-mini-img { height: 200px !important; object-fit: cover; }
        .loading-spinner .spinner-border { width: 3rem; height: 3rem; }
    </style>
</head>
<body class="bg-dark text-light">

<div id="user-details" class="container my-4">

    <!-- HEADER -->
    <section class="row mb-4">
        <div class="col-12">
            <h1 id="user-username" class="h2 mb-1">Caricamento...</h1>
            <h2 id="user-displayname" class="h5 text-muted mb-3"></h2>

            <div class="mb-3">
                <p id="user-stats-summary" class="mb-1 fs-5"></p>
                <p id="user-location-age" class="mb-0 text-light-50"></p>
            </div>

            <div class="mb-2 fs-5">
                <p id="user-total-stats" class="mb-0 fw-bold"></p>
            </div>
        </div>
    </section>

    <!-- TAB -->
    <ul class="nav nav-tabs mb-3" id="user-tabs">
        <li class="nav-item">
            <button class="nav-link active" data-section="profile-section">Profile</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-section="list-section">Anime List</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-section="favs-section">Favourites</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-section="stats-section">Stats</button>
        </li>
    </ul>

    <!-- PROFILE -->
    <section id="profile-section">
        <section class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">Stats Summary</h3>
                        <div class="fs-5">
                            <p id="user-stats-watching" class="mb-1"></p>
                            <p id="user-stats-completed" class="mb-1"></p>
                            <p id="user-stats-onhold" class="mb-1"></p>
                            <p id="user-stats-dropped" class="mb-1"></p>
                            <p id="user-stats-plantowatch" class="mb-0"></p>
                        </div>
                        <small class="text-light-50">For full stats see the "Stats" tab.</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body">
                        <h3 class="h5 card-title">Profile Info</h3>
                        <p id="user-location" class="mb-2 fs-6"></p>
                        <p id="user-joined" class="mb-2 fs-6"></p>
                        <p id="user-gender" class="mb-0 fs-6"></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- RECENT -->
        <section class="mb-4">
            <h3 class="h4 mb-3">Recent Activity (top 8)</h3>
            <div id="user-recent-list" class="row g-3"></div>
            <small class="text-light-50">For full list see "Anime List" tab.</small>
        </section>
    </section>

    <!-- LIST -->
    <section id="list-section" style="display: none;">
        <h3 class="h4 mb-3">Anime List</h3>
        <div class="mb-3">
            Status:
            <select id="list-status-filter" class="form-select form-select-sm d-inline-block w-auto ms-2">
                <option value="All">All</option>
                <option value="watching">Watching</option>
                <option value="completed">Completed</option>
                <option value="on_hold">On Hold</option>
                <option value="dropped">Dropped</option>
                <option value="plan_to_watch">Plan to Watch</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-dark table-sm">
                <thead class="table-secondary text-dark">
                <tr><th>Anime</th><th>Status</th><th>Score</th><th>Ep. Watched</th><th>Rewatch</th></tr>
                </thead>
                <tbody id="user-anime-list-body"></tbody>
            </table>
        </div>
        <!-- controlli paginazione -->
        <div id="list-pagination-controls" class="d-flex justify-content-between align-items-center mt-2">
            <span id="list-page-info" class="small"></span>
            <div>
                <button id="list-prev" type="button" class="btn btn-sm btn-outline-light me-2">Prev</button>
                <button id="list-next" type="button" class="btn btn-sm btn-outline-light">Next</button>
            </div>
        </div>
    </section>

    <!-- FAVS -->
    <section id="favs-section" style="display: none;">
        <h3 class="h4 mb-3">Favourites</h3>
        <div id="user-favourites-grid" class="row g-3"></div>
    </section>

    <!-- STATS -->
    <section id="stats-section" style="display: none;">
        <h3 class="h4 mb-3">Stats</h3>
        <div class="card bg-secondary text-light">
            <div class="card-body">
                <h4 class="h6 mb-3">Score Distribution</h4>
                <table class="table table-sm table-dark table-bordered mb-0">
                    <thead class="table-secondary text-dark">
                    <tr><th>Score</th><th>Count</th><th>%</th></tr>
                    </thead>
                    <tbody id="user-score-distribution"></tbody>
                </table>
            </div>
        </div>
    </section>

</div>

<!-- TEMPLATE OBBLIGATORIO -->
<template id="anime-mini-card-template">
    <div class="col-6 col-md-4 col-lg-3">
        <div class="card h-100 bg-secondary text-light">
            <img src="" alt="" class="card-img-top anime-mini-img" style="height: 200px; object-fit: cover;">
            <div class="card-body p-2">
                <a href="#" class="anime-mini-title h6 mb-1 text-light text-decoration-none"></a>
                <p class="anime-mini-status small text-light-50 mb-0"></p>
            </div>
        </div>
    </div>
</template>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/javascripts/user-details.js"></script>

</body>
</html>
