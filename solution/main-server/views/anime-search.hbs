<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8"/>
    <title>{{title}}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.7/dist/axios.min.js"></script>
</head>
<body class="bg-dark text-light">
<div class="container py-4">
    <h1 class="mb-4">Ricerca Anime</h1>

    <!-- RICERCA ANIME -->
    <form id="search-form" class="mb-4">
        <div class="input-group">
            <input type="text" id="title-input" class="form-control"
                   placeholder="Inserisci titolo dell'anime" minlength="3" required/>
            <button class="btn btn-primary" type="submit" id="search-button" disabled>Search Anime</button>
        </div>
    </form>

    <section id="results-section" class="d-none">
        <h2 class="h4 mb-3">Risultati Anime</h2>

        <ul id="results" class="list-group list-group-flush">

            <!-- template nascosto per un singolo elemento della lista -->
            <li id="anime-item-template"
                class="list-group-item bg-dark text-light d-none anime-list-item anime-result-link"
                data-anime-id="">
                <div class="d-flex align-items-center">
                    <img src="" alt="Poster anime" class="anime-poster me-3" style="width:60px; height:auto;">
                    <div>
                        <h5 class="mb-1 anime-title">Titolo</h5>
                        <small>
                            Titolo giapponese:
                            <span class="title-japanese"></span>
                            &nbsp;|&nbsp;
                            Score:
                            <span class="anime-score"></span>
                            &nbsp;|&nbsp;
                            Tipo:
                            <span class="anime-type"></span>
                        </small>
                    </div>
                </div>
            </li>

        </ul>

        <nav aria-label="Page navigation" id="pagination-nav" class="mt-3 d-none">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item">
                    <button class="page-link" id="prev-page" type="button">
                        Previous
                    </button>
                </li>

                <li class="page-item disabled">
                    <span class="page-link" id="page-info">
                        Pagina 1 di 1
                    </span>
                </li>

                <li class="page-item">
                    <button class="page-link" id="next-page" type="button">
                        Next
                    </button>
                </li>
            </ul>
        </nav>
    </section>

    <!-- RICERCA UTENTI -->
    <h2 class="mt-5 mb-3">Ricerca Utenti</h2>

    <form id="user-search-form" class="mb-3">
        <div class="input-group">
            <input type="text" id="username-input" class="form-control"
                   placeholder="Inserisci username" minlength="2" required/>
            <button class="btn btn-primary" type="submit" id="user-search-button" disabled>
                Search user
            </button>
        </div>
    </form>

    <ul id="user-results" class="list-group list-group-flush mb-3"></ul>
    <p id="user-message" class="small d-none"></p>

    <p id="message" class="mt-3 d-none"></p>
</div>

<script src="/javascripts/anime-search.js"></script>
</body>
</html>
